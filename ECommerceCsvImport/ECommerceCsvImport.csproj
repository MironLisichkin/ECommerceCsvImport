<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- Тесты живут в отдельном проекте и не должны компилироваться в веб-проект -->
    <Compile Remove="ECommerceCsvImport.Tests\**" />
    <Content Remove="ECommerceCsvImport.Tests\**" />
    <EmbeddedResource Remove="ECommerceCsvImport.Tests\**" />
    <None Remove="ECommerceCsvImport.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="wwwroot\csv\sample_products.csv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
